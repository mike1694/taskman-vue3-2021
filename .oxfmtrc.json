{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 70,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": ["**/node_modules/**", "backend/dist/**", "backend/data/**", "**/*.min.js"]
}