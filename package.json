{
  "name": "taskman-vue3-ts-scss-eslint",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "vite",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "prod": "npm run build && docker-compose up --build -d",
    "prod:stop": "docker-compose down",
    "prod:restart": "npm run build && docker-compose up --build -d",
    "lint": "oxlint src backend vite.config.mts",
    "lint:fix": "oxlint --fix src backend vite.config.mts",
    "format": "oxfmt src backend vite.config.mts",
    "format:check": "oxfmt --check src backend vite.config.mts"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^8.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "sass": "^1.106.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
