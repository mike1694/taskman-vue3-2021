{
  "name": "taskman-vue3-ts-scss-eslint",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "vite",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "prod": "npm run build && docker-compose up --build -d",
    "prod:stop": "docker-compose down",
    "prod:restart": "npm run build && docker-compose up --build -d",
    "lint": "eslint --ext .js,.ts,.vue src"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^11.0.3",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.33.0",
    "sass": "^1.106.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
